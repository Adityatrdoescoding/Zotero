type = viz name = vis01 start_res = 1 end_res = 100 step_res = 1 format = vtk wake = T variable = vorticity }
analysis = {
type = integral_loads name = load01 start_res = 1 end_res = 100 step_res = 1 format = dat average = F component = all reference_tag = RotorHub }
